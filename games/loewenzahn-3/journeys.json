{
  "schema_version": 1,
  "journeys": [
    {
      "name": "opening-login",
      "description": "Select a profile, enter the introduction and wagon bedroom, verify preferences and sustain playback.",
      "covers": [
        "startup",
        "video-cast-selection",
        "preferences",
        "profile-selection",
        "sustained-playback",
        "navigation",
        "save"
      ],
      "steps": [
        {
          "expect": {
            "movie": "START.DXR"
          },
          "label": "launcher"
        },
        {
          "wait": {
            "movie": "LOGIN.DXR"
          },
          "ticks": 6000,
          "label": "login"
        },
        {
          "idle": 3600,
          "expect": {
            "movie": "LOGIN.DXR"
          },
          "label": "login-playback"
        },
        {
          "click": [
            140,
            168
          ],
          "settle": 120,
          "expect": {
            "globals.gloginlist": "[#igel]"
          },
          "label": "profile-selected"
        },
        {
          "click": [
            365,
            562
          ],
          "settle": 3600,
          "expect": {
            "movie": "INTRO.DXR",
            "save_generation": {
              "gte": 2
            }
          },
          "label": "profile-saved"
        },
        {
          "click": [
            400,
            300
          ],
          "settle": 3600,
          "expect": {
            "movie": "BWBETT.DXR"
          },
          "label": "wagon-bedroom"
        },
        {
          "idle": 3600,
          "expect": {
            "movie": "BWBETT.DXR"
          },
          "label": "bedroom-playback"
        }
      ]
    }
  ]
}
