{
  "schema_version": 1,
  "journeys": [
    {
      "name": "opening-player-screen",
      "description": "Play the launcher into the player screen and exercise its directory discovery, queued speech and cue-driven actors.",
      "covers": [
        "startup",
        "profile-discovery",
        "linked-audio",
        "cue-points",
        "sustained-playback"
      ],
      "steps": [
        {
          "expect": {
            "movie": "START.DXR"
          },
          "label": "launcher"
        },
        {
          "wait": {
            "movie": "A000.DXR"
          },
          "ticks": 3600,
          "label": "player-screen"
        },
        {
          "idle": 3600,
          "expect": {
            "movie": "A000.DXR"
          },
          "label": "opening-playback"
        }
      ]
    }
  ]
}
