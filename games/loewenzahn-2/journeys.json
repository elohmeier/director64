{
  "schema_version": 1,
  "journeys": [
    {
      "name": "intro-wagon",
      "description": "Play the startup and QuickTime intro into the wagon exterior, then keep the scene running.",
      "covers": [
        "startup",
        "video",
        "navigation",
        "sustained-playback"
      ],
      "steps": [
        {
          "expect": {
            "movie": "START.DXR"
          },
          "label": "launcher"
        },
        {
          "wait": {
            "movie": "BAUWAGEN.DXR"
          },
          "ticks": 18000,
          "label": "wagon"
        },
        {
          "idle": 3600,
          "expect": {
            "movie": "BAUWAGEN.DXR"
          },
          "label": "wagon-playback"
        }
      ]
    }
  ]
}
