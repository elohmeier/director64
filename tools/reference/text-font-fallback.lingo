-- Synthetic requested-font fallback and property-order observations.
global out
out=new(xtra("fileio"))
out.createFile("C:\text-font-fallback.txt")
out.openFile("C:\text-font-fallback.txt",2)
w=window("director64-probe")
w.fileName=the applicationPath & "DEBUG\ALLGEMEI\LOGFILE.DXR"
w.open()
tell w
 repeat with order in [#beforeText,#afterText]
  repeat with requested in ["Arial","Corsetta","Elephant","Missing-Test-Font","Times New Roman","Courier New"]
   t=new(#text)
   t.width=200
   if order=#afterText then t.text="abc ABC 012 iii WWW"
   t.font=requested
   t.fontSize=18
   if order=#beforeText then t.text="abc ABC 012 iii WWW"
   a=t.image.extractAlpha()
   total=0
   weighted=0
   repeat with y=0 to a.height-1
    repeat with x=0 to a.width-1
     c=a.getPixel(point(x,y),#integer)
     total=total+c
     weighted=weighted+(c*(x+1)*(y+1))
    end repeat
   end repeat
   out.writeString(string([order,requested,t.font,t.rect,a.rect,total,weighted]) & RETURN)
  end repeat
 end repeat
end tell
out.closeFile()
