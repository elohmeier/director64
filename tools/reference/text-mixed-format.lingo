-- Synthetic character runs and row geometry in an original8.5 movie context.
global out
out=new(xtra("fileio"))
out.createFile("C:\text-mixed-format.txt")
out.openFile("C:\text-mixed-format.txt",2)
w=window("director64-probe")
w.fileName=the applicationPath & "DEBUG\ALLGEMEI\LOGFILE.DXR"
w.open()
tell w
 t=new(#text)
 t.width=60
 t.font="Arial"
 t.fontSize=12
 t.text="ABCD EF"
 t.char[3..7].fontSize=24
 t.char[3..7].fontStyle=[#bold]
 repeat with alignment in [#left,#center,#right]
  t.alignment=alignment
  out.writeString(string([alignment,t.rect,t.image.rect]) & RETURN)
  repeat with i=1 to t.text.length+1
   out.writeString(string([i,charPosToLoc(t,i)]) & RETURN)
  end repeat
 end repeat
end tell
out.closeFile()
