-- Synthetic classic-field highlight indices and compound style getter.
global out
out=new(xtra("fileio"))
out.createFile("C:\text-hilite.txt")
out.openFile("C:\text-hilite.txt",2)
w=window("director64-probe")
w.fileName=the applicationPath & "DEBUG\ALLGEMEI\LOGFILE.DXR"
w.open()
tell w
 t=member(7,1)
 t.text="AB CD"
 t.font="Arial"
 t.fontSize=18
 t.editable=TRUE
 puppetSprite(1,TRUE)
 sprite(1).member=t
 sprite(1).rect=rect(100,100,300,140)
 sprite(1).visible=TRUE
 updateStage()
 hilite char 2 to 4 of field 7
 out.writeString(string(["range",the selStart,the selEnd]) & RETURN)
 hilite char 2147483647 to 2147483647 of field 7
 out.writeString(string(["clear",the selStart,the selEnd]) & RETURN)
 t.fontStyle="bold, italic"
 out.writeString(string(["style",ilk(t.fontStyle),t.fontStyle]) & RETURN)
end tell
out.closeFile()
