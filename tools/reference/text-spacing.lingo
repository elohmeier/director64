-- Synthetic live fixedLineSpace and character-spacing observations.
global out
out=new(xtra("fileio"))
out.createFile("C:\text-spacing.txt")
out.openFile("C:\text-spacing.txt",2)
w=window("director64-probe")
w.fileName=the applicationPath & "DEBUG\ALLGEMEI\LOGFILE.DXR"
w.open()
tell w
 t=new(#text)
 t.width=100
 t.font="Arial"
 t.fontSize=18
 t.text="ABCD" & RETURN & "EF"
 repeat with leading in [0,32,10]
  t.fixedLineSpace=leading
  repeat with spacing in [0,2,-2]
   t.charSpacing=spacing
   out.writeString(string([leading,spacing,t.rect]) & RETURN)
   repeat with i=1 to t.text.length+1
    out.writeString(string([i,charPosToLoc(t,i)]) & RETURN)
   end repeat
  end repeat
 end repeat
 t.charSpacing=0
 t.fixedLineSpace=0
 t.char[2].charSpacing=4
 repeat with i=1 to 5
  out.writeString(string([#range,i,charPosToLoc(t,i)]) & RETURN)
 end repeat
end tell
out.closeFile()
