-- Query an untouched classic field whose CASt box type byte is 2.
global out
out=new(xtra("fileio"))
out.createFile("C:\text-source-box-type.txt")
out.openFile("C:\text-source-box-type.txt",2)
w=window("director64-probe")
w.fileName=the applicationPath & "DEBUG\ALLGEMEI\LOGFILE.DXR"
w.open()
tell w
 t=member(7,1)
 out.writeString(string([t.name,t.type,t.boxType,t.rect,t.pageHeight]) & RETURN)
end tell
out.closeFile()
