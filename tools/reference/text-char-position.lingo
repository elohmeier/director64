-- Synthetic one-based charPosToLoc alignment/line placement observations.
global out
out=new(xtra("fileio"))
out.createFile("C:\text-char-position.txt")
out.openFile("C:\text-char-position.txt",2)
w=window("director64-probe")
w.fileName=the applicationPath & "DEBUG\ALLGEMEI\LOGFILE.DXR"
w.open()
tell w
 t=new(#text)
 t.width=100
 t.font="Arial"
 t.fontSize=18
 repeat with alignment in [#left,#center,#right]
  t.alignment=alignment
  repeat with content in ["WI","abc" & RETURN & "de","abcdefghijklmno",""]
   t.text=content
   repeat with i=1 to content.length+1
    out.writeString(string([alignment,content,i,charPosToLoc(t,i)]) & RETURN)
   end repeat
  end repeat
 end repeat
end tell
out.closeFile()
