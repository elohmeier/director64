-- Synthetic pixel inputs only; see docs/reference-capture.md.
global out, pm, qm, nm, p, q, maskimg
out=new(xtra("fileio"))
out.createFile("C:\ink-mask-bitmap.txt")
out.openFile("C:\ink-mask-bitmap.txt",2)
qm=new(#bitmap)
pm=new(#bitmap)
nm=new(#bitmap)
pm.name="synthetic-source"
nm.name="unrelated-next-bitmap"
p=image(8,8,32)
p.fill(rect(0,0,8,8),rgb(255,0,0))
q=image(8,8,32)
q.fill(rect(0,0,8,8),rgb(0,0,255))
pm.image=p
qm.image=q
puppetSprite(148,1)
puppetSprite(149,1)
sprite(148).member=qm
sprite(149).member=pm
sprite(148).rect=rect(0,0,8,8)
sprite(149).rect=rect(0,0,8,8)
sprite(148).ink=0
sprite(149).ink=9
sprite(149).color=rgb(0,0,0)
sprite(149).bgColor=rgb(255,255,255)
sprite(149).blend=100
out.writeString(string([pm.number,nm.number]) & RETURN)
repeat with depth in [4,8]
 repeat with sc in [rgb(0,0,0),rgb(128,128,128),rgb(255,255,255)]
  maskimg=image(depth,depth,32)
  maskimg.fill(rect(0,0,depth,depth),sc)
  nm.image=maskimg
  updateStage
  exterior=(the stage).image.getPixel(point(0,0))
  interior=(the stage).image.getPixel(point(4,4))
  stagePixel=(the stage).image.getPixel(point(7,4))
  out.writeString(string([depth,sc,exterior,interior,stagePixel]) & RETURN)
 end repeat
end repeat
out.closeFile()
