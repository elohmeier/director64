-- Synthetic eight-bit palette indices only; no game media.
global out, p, q, paletteIndex
out=new(xtra("fileio"))
out.createFile("C:\palette-mac-eight.txt")
out.openFile("C:\palette-mac-eight.txt",2)
p=image(256,1,8,#systemMac)
q=image(256,1,32)
repeat with paletteIndex=0 to 255
 p.setPixel(point(paletteIndex,0),paletteIndex)
end repeat
q.copyPixels(p,rect(0,0,256,1),rect(0,0,256,1),[#ink:0])
repeat with paletteIndex=0 to 255
 out.writeString(string([paletteIndex,p.getPixel(point(paletteIndex,0)),q.getPixel(point(paletteIndex,0))])&RETURN)
end repeat
out.closeFile()
