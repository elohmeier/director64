-- Synthetic large negative tracking in an original8.5 modern Text member.
global out
out=new(xtra("fileio"))
out.createFile("C:\text-large-spacing.txt")
out.openFile("C:\text-large-spacing.txt",2)
w=window("director64-probe")
w.fileName=the applicationPath & "DEBUG\ALLGEMEI\LOGFILE.DXR"
w.open()
tell w
 t=new(#text)
 t.font="Arial"
 t.fontSize=18
 t.width=100
 t.text="ABCD"
 repeat with spacing in [0,-2,-1000,4]
  t.charSpacing=spacing
  out.writeString(string([spacing,t.charSpacing,t.rect,charPosToLoc(t,1),charPosToLoc(t,2),charPosToLoc(t,3),charPosToLoc(t,5)]) & RETURN)
 end repeat
end tell
out.closeFile()
