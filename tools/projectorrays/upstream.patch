+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. See https://mozilla.org/MPL/2.0/. */
+#ifndef DIRECTOR_SCORECHUNK_H
+#define DIRECTOR_SCORECHUNK_H
+#include "common/stream.h"
+#include "director/chunk.h"
+#include "director/score_recovery.h"
+
+namespace Director {
+struct ScoreRecoveryChunk : Chunk {
+    std::string fourCC;
+    ScoreRecovery::Recovery recovery;
+    ScoreRecoveryChunk(DirectorFile *file, std::string type)
+        : Chunk(file, kScoreRecoveryChunk), fourCC(std::move(type)) {}
+    void read(Common::ReadStream &stream) override;
+    void writeJSON(Common::JSONWriter &json) const override;
+};
+}
+#endif
