+++ b/src/director/scorechunk.cpp
@@ -0,0 +1,16 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. See https://mozilla.org/MPL/2.0/. */
+#include "director/scorechunk.h"
+#include "director/dirfile.h"
+#include "common/json.h"
+#include "common/stream.h"
+
+namespace Director {
+void ScoreRecoveryChunk::read(Common::ReadStream &stream) {
+    recovery = ScoreRecovery::decode(fourCC, stream.data(), stream.size(), dir->version);
+    stream.seek(stream.size());
+}
+void ScoreRecoveryChunk::writeJSON(Common::JSONWriter &json) const {
+    json.writeRawJSON(recovery.toJSON());
+}
+}
