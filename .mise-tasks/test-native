    if [ "$profile" = 10 ]; then options+=(-DDIRECTOR64_EXTENDED_D6=1); fi
    if [ "$profile" = 85 ]; then version=10; options+=(-DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1); fi
    compile "cursor_roles_d$profile" "${options[@]}" -DDIRECTOR64_DIRECTOR_VERSION="$version" \
        tests/native/test_cursor_roles.c runtime/director/director.c runtime/lingo/lingo_runtime.c
done
compile loewenzahn_printing -DDIRECTOR64_DIRECTOR_VERSION=5 -Igames/loewenzahn-1/runtime -Igames/loewenzahn-1/tests/printing-fixtures games/loewenzahn-1/tests/test_printing.c games/loewenzahn-1/runtime/printing.c runtime/lingo/lingo_runtime.c
compile director_d8_events -DDIRECTOR64_DIRECTOR_VERSION=8 tests/native/test_director_d8_events.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_d8_controls -DDIRECTOR64_DIRECTOR_VERSION=8 tests/native/test_director_d8_controls.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile mucklas_controls -DDIRECTOR64_DIRECTOR_VERSION=8 -Igames/findus-mucklas/runtime games/findus-mucklas/tests/test_controls.c games/findus-mucklas/runtime/controls.c runtime/interaction/input.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_text -DDIRECTOR64_DIRECTOR_VERSION=8 tests/native/test_director_text.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile shape tests/native/test_shape.c runtime/director/shape.c
compile bitmap_tiles tests/native/test_bitmap_tiles.c
compile image_alpha tests/native/test_image_alpha.c
compile image_plan tests/native/test_image_plan.c
compile mpeg_decoder -Wno-unused-parameter tests/native/test_mpeg_decoder.c
compile ink_projector -DDIRECTOR64_DIRECTOR_VERSION=10 tests/native/test_ink_projector.c
compile rich_text_d6 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_rich_text.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile rich_text_d7 -DDIRECTOR64_DIRECTOR_VERSION=7 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_rich_text.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile rich_text_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_rich_text.c runtime/director/director.c runtime/lingo/lingo_runtime.c



compile director_d7 -DDIRECTOR64_DIRECTOR_VERSION=7 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_d7.c runtime/director/director.c runtime/lingo/lingo_runtime.c



compile director_d7_frame_events -DDIRECTOR64_DIRECTOR_VERSION=7 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_d6_frame_events.c runtime/director/director.c runtime/lingo/lingo_runtime.c

compile quicktime_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_quicktime.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile quicktime_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_quicktime.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile flash_variants_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_flash_variants.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile flash_variants_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_flash_variants.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile flash_playback_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_flash_playback.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile flash_playback_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_flash_playback.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile film_sounds_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_film_sounds.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile film_sounds_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_film_sounds.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile linked_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_linked_movies.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile linked_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_linked_movies.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile keyboard_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_keyboard.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile keyboard_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_keyboard.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile imaging_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_imaging.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile imaging_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_imaging.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_d10.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_playback_d10 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_playback.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_playback_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_director_playback.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile web_audio_d10 -Iplatforms/web -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_web_audio.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile web_audio_d85 -Iplatforms/web -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 tests/native/test_web_audio.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile flash_audio_hosts -Iplatforms/web -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_flash_audio_hosts.c
# The D7/D10 lenient absent-cursor path conflicts with test_cursor's strict
# D5/D6/D8 contract; test_director_d10.c covers the versioned behavior instead.
compile director_d10_frame_events -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_d6_frame_events.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile web_compositor -Iplatforms/web tests/native/test_web_compositor.c platforms/web/compositor.c runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c
compile shape_palette_d6_plain -Iplatforms/web tests/native/test_shape_palette.c platforms/web/compositor.c runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c
for profile in 5 6 7 8 10 85; do
    palette_options=(-DDIRECTOR64_DIRECTOR_VERSION="$profile")
    if [ "$profile" = 6 ] || [ "$profile" = 7 ] || [ "$profile" = 10 ]; then palette_options+=(-DDIRECTOR64_EXTENDED_D6=1); fi
    if [ "$profile" = 85 ]; then palette_options=(-DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1); fi
    compile "shape_palette_d$profile" "${palette_options[@]}" -DDIRECTOR64_NATIVE_STAGE=1 -Iplatforms/web tests/native/test_shape_palette.c platforms/web/compositor.c runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c
done
compile web_raster_casts -Iplatforms/web tests/native/test_web_raster_casts.c platforms/web/compositor.c runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c
compile web_raster_casts_extended_d6 -DDIRECTOR64_EXTENDED_D6=1 -Iplatforms/web tests/native/test_web_raster_casts.c platforms/web/compositor.c runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c
compile web_raster_casts_d85 -DDIRECTOR64_NATIVE_STAGE=1 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 -Iplatforms/web tests/native/test_web_raster_casts.c platforms/web/compositor.c runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c
for profile in d5 d6_extended d7 d8 d10 d85; do
    options=(-DDIRECTOR64_NATIVE_STAGE=1)
    case "$profile" in
        d5) options+=(-DDIRECTOR64_DIRECTOR_VERSION=5) ;;
        d6_extended) options+=(-DDIRECTOR64_EXTENDED_D6=1) ;;
        d7) options+=(-DDIRECTOR64_DIRECTOR_VERSION=7 -DDIRECTOR64_EXTENDED_D6=1) ;;
        d8) options+=(-DDIRECTOR64_DIRECTOR_VERSION=8) ;;
        d10) options+=(-DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1) ;;
        d85) options+=(-DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1) ;;
    esac
    compile "web_compositor_fixes_$profile" "${options[@]}" -Iplatforms/web \
        tests/native/test_web_compositor_fixes.c platforms/web/compositor.c \
        runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c
done
for profile in d10 d85; do
    options=(-DDIRECTOR64_NATIVE_STAGE=1 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1)
    if [ "$profile" = d85 ]; then options+=(-DDIRECTOR64_D85=1); fi
    for test in avm1 avm1_original avm1_native flash_instances flash_masks flash_lifetime film_children film_playback flash_bridge cursor_xtra; do
