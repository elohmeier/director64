#!/usr/bin/env bash
#MISE description="Run portable runtime and game adapter C contracts"
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mkdir -p build/tests
python3 tools/reference/generate_avm1_fixtures.py build/tests/avm1_original.h
includes=(-Iruntime/director -Iruntime/lingo -Iruntime/interaction -Iruntime/storage)
compile() {
    local name=$1
    shift
    "${CC:-cc}" -std=c17 -Wall -Wextra -Werror -pedantic "${includes[@]}" "$@" -lm -o "build/tests/$name"
    "build/tests/$name"
}
for budget in default override; do
    options=(-DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1)
    if [ "$budget" = override ]; then
        options+=(-DEXPECT_OVERRIDE=1 -DLV_HEAP_BYTES=1572864 -DLV_OBJECTS=10000)
    fi
    compile "runtime_budget_$budget" "${options[@]}" tests/native/test_runtime_budget.c
done
compile lingo tests/native/test_lingo.c runtime/lingo/lingo_runtime.c
for profile in 5 6 6e 7 8 10 85; do
    version="$profile"
    options=()
    if [ "$profile" = 6e ]; then version=6; options+=(-DDIRECTOR64_EXTENDED_D6=1); fi
    if [ "$profile" = 10 ]; then options+=(-DDIRECTOR64_EXTENDED_D6=1); fi
    if [ "$profile" = 85 ]; then version=10; options+=(-DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1); fi
    compile "lingo_numeric_d$profile" "${options[@]}" -DDIRECTOR64_DIRECTOR_VERSION="$version" \
        tests/native/test_lingo_numeric.c runtime/lingo/lingo_runtime.c
done
compile xml_optional_alias_d85 -DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1 -DDIRECTOR64_D85=1 \
    tests/native/test_xml_optional_alias.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile audio_release tests/native/test_audio_release.c
compile android_decode -Itests/native/android_stubs tests/native/test_android_decode.c
compile android_input tests/native/test_android_input.c
for profile in d10 d85; do
    options=(-DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1)
    if [ "$profile" = d85 ]; then options+=(-DDIRECTOR64_D85=1); fi
    compile "android_key_queue_$profile" "${options[@]}" tests/native/test_android_key_queue.c \
        runtime/director/director.c runtime/lingo/lingo_runtime.c
done
for host in video mixer; do
    compile "android_$host" -DDIRECTOR64_DIRECTOR_VERSION=5 -Iplatforms/web \
        -Itests/native/android_stubs -ffunction-sections -fdata-sections -Wl,--gc-sections \
        -pthread "tests/native/test_android_$host.c"
done
for profile in d5 d10 d85; do
    options=(-DDIRECTOR64_PACKAGE -DDIRECTOR64_NATIVE_STAGE=1)
    if [ "$profile" = d5 ]; then
        options+=(-DDIRECTOR64_DIRECTOR_VERSION=5)
    else
        options+=(-DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_EXTENDED_D6=1)
    fi
    if [ "$profile" = d85 ]; then options+=(-DDIRECTOR64_D85=1); fi
    compile "web_lifecycle_$profile" "${options[@]}" -Iruntime/package -Iplatforms/web \
        tests/native/test_web_lifecycle.c platforms/web/compositor.c \
        runtime/director/{director,shape}.c runtime/lingo/lingo_runtime.c runtime/package/package.c
done
compile lingo_d8 -DDIRECTOR64_DIRECTOR_VERSION=8 tests/native/test_lingo_d8.c runtime/lingo/lingo_runtime.c
compile lingo_collect tests/native/test_lingo_collect.c runtime/lingo/lingo_runtime.c
compile lingo_collect_extended_d6 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_lingo_collect.c runtime/lingo/lingo_runtime.c
compile saves -Iruntime -Itests/native/saves_profile tests/native/test_saves.c runtime/storage/saves.c
for test in director director_timing director_state; do
    compile "$test" "tests/native/test_$test.c" runtime/director/director.c runtime/lingo/lingo_runtime.c
done
compile pointer tests/native/test_pointer.c runtime/interaction/{pointer,input}.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_d8 -DDIRECTOR64_DIRECTOR_VERSION=8 tests/native/test_director_d8.c runtime/director/director.c runtime/lingo/lingo_runtime.c
for profile in 5 6 8 10 85; do
    options=()
    if [ "$profile" = 6 ] || [ "$profile" = 10 ] || [ "$profile" = 85 ]; then
        options+=(-DDIRECTOR64_EXTENDED_D6=1)
    fi
    if [ "$profile" = 85 ]; then
        options+=(-DDIRECTOR64_DIRECTOR_VERSION=10 -DDIRECTOR64_D85=1)
    else
        options+=(-DDIRECTOR64_DIRECTOR_VERSION="$profile")
    fi
    compile "sound_fades_d$profile" "${options[@]}" tests/native/test_sound_fades.c runtime/director/director.c runtime/lingo/lingo_runtime.c
done
compile director_d6 -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_d6.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_d6_events -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_d6_events.c runtime/director/director.c runtime/lingo/lingo_runtime.c
compile director_d6_frame_events -DDIRECTOR64_EXTENDED_D6=1 tests/native/test_director_d6_frame_events.c runtime/director/director.c runtime/lingo/lingo_runtime.c
