#!/usr/bin/env bash
#MISE description="Run host-tool tests, lint, tracker validation and Node syntax checks"
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v cargo >/dev/null 2>&1; then
    echo "check requires the Rust compiler; install the pinned toolchain with mise install" >&2
    exit 1
fi
cargo build --release --manifest-path compiler/Cargo.toml
uv run --locked ruff check src tests games
uv run --locked pytest
node --check tools/director/dump.mjs
node --check tools/director/dump-format.mjs
node --check platforms/web/site/app.js
node --check platforms/web/site/player.js
for module in gamepad keyboard screen settings strings ui; do
    node --check "platforms/web/site/$module.js"
done
node --check platforms/web/node/probe.mjs
node --test tests/node/*.test.mjs
"$repo_root/.mise-tasks/test-native"
"$repo_root/.mise-tasks/test-android-host"
cargo test --release --manifest-path compiler/Cargo.toml
